# 本地演示可直接省略，系统会使用下列默认 SQLite 地址和开发密钥。
# 部署时务必替换为随机长字符串，并将 DATABASE_URL 指向持久化目录。
DATABASE_URL=file:./seed/aqian.db
COOKIE_SIGNING_SECRET=replace-with-a-long-random-secret-in-production

# 下一阶段接入模型/高德时使用；当前规则与核验知识库路径不依赖它们。
# AMAP_KEY 必须是高德控制台申请的「Web 服务 API」类型 Key；它只在服务端调用真实驾车路径规划。
# 如需把高德底图也嵌入浏览器，再额外申请「Web 端（JS API）」Key 与安全密钥，勿提交到仓库。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
AMAP_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
# 腾讯位置服务 WebService API Key：用于旅游行程图的坐标、车程与路线折线；只放服务端。
TENCENT_MAP_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
